---
/**
 * Une page de `src/content/pages/`. Page outil ou ville : H1, réponse repliée, l'outil, puis le corps.
 * Guide : H1, la réponse, son mini-simulateur, puis le corps. FAQ, pages liées, sources, éditeur : PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, pageCountry } from '../lib/pages';
import { helpers, SOURCES } from '../lib/helpers';
import { groupInfo, COUNTRY } from '../lib/topics';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'es';
const ui = t(lang);
const path = route(page.id, lang);
const g = groupInfo(page.group);
const ctry = COUNTRY[pageCountry(page)];
const parts = page.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const tag = ctry.tag;
const jsonLd = [articleSchema({ title: page.h1, description: page.description, path, lang, tag }), webPageSchema({ name: page.h1, description: page.description, path, lang, tag }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: page.h1, description: page.description, path, lang, tag, currency: ctry.currency }));
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang, tag));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: pageById(id)?.card ?? '' }));
const sources = page.sources.map((k) => { const s = SOURCES[k]; if (!s) throw new Error(`${page.id}: source inconnue ${k}`); return { name: s.label, url: s.url }; });
const methodHref = route('method', lang);
const toolHref = { hnc: 'hoy-no-circula', verif: 'verificacion-vehicular', 'pyp-ciudad': 'pico-y-placa', 'pyp-reglas': 'pico-y-placa' }[page.group];
const miniTarget = page.miniHref ?? toolHref;
const miniHref = ROUTES.some((r) => r.id === miniTarget) ? route(miniTarget, lang) : route('home', lang);
const kicker = page.kind === 'city' ? `Pico y placa · ${ctry.name}` : `${g.short} · ${ctry.name}`;
const tp = page.toolProps ?? {};
---
<PageLayout title={page.title} description={page.description} lang={lang} langTag={tag} ogLocale={ctry.og} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: page.nav }]}>
  <article>
    <header class="mb-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-accent-700 sm:text-sm">{kicker}</p>
      <h1 class="mt-1 font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{page.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{page.intro}</p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        <div data-outil class="mb-4"><Tool kind={page.tool} {...tp} idPrefix={page.id.slice(0, 8)} /></div>
        <p class="mb-10 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method')}</a></p>
      </>
    ) : (
      <>
        <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-2" />
        {page.mini && <MiniSim client:load spacing="mb-4 mt-2" kind={page.mini} arg={page.miniArg === undefined ? undefined : JSON.stringify(page.miniArg)} href={miniHref} />}
        <p class="mb-8 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method')}</a></p>
      </>
    )}
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={miniHref} /> : null)}
    </div>
  </article>
</PageLayout>
