---
import BaseLayout from '../layouts/BaseLayout.astro';
import { route, DEFAULT_LOCALE } from '../i18n/routes';
import { t } from '../i18n/ui';
const ui = t(DEFAULT_LOCALE);
import { ROUTES } from '../i18n/routes';
const links = ([['home', '¿Circulo hoy?'], ['hoy-no-circula', 'Hoy No Circula CDMX'], ['pico-y-placa', 'Pico y placa en Colombia']] as const).filter(([id]) => ROUTES.some((r) => r.id === id));
---
<BaseLayout title="Página no encontrada: ¿Puedo circular hoy?" description="Esta dirección no existe en ¿Puedo circular hoy?." lang={DEFAULT_LOCALE} noindex={true}>
  <div class="mx-auto max-w-6xl px-4 py-16"><p class="text-sm font-semibold uppercase tracking-wide text-accent-700">Error 404</p><h1 class="mt-2 font-serif text-3xl font-bold text-navy-900">Esta calle no tiene salida</h1><p class="mt-4 text-navy-700">{ui.notFound}</p><p class="mt-6 flex flex-wrap gap-3">{links.map(([id, l]) => <a href={route(id, DEFAULT_LOCALE)} class="rounded-lg border border-navy-300 px-4 py-2 font-semibold text-navy-900 hover:bg-navy-50">{l}</a>)}</p></div>
</BaseLayout>
