---
/** Iframe : la consulta Hoy No Circula nue, avec le lien de crédit (noindex, hors sitemap). */
import '../../styles/global.css';
import HncTool from '../../components/calc/HncTool';
import { MX } from '../../lib/kit';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="es-MX"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Hoy No Circula: consulta para insertar</title><link rel="canonical" href={`${SITE_URL}${route('hoy-no-circula', 'es')}`} /></head>
<body class="bg-white p-3 text-navy-900">
  <HncTool client:load p={{ hnc: MX.hnc }} methodHref={`${SITE_URL}${route('method', 'es')}`} idPrefix="emb" />
  <p class="mt-3 text-center text-sm"><a href={`${SITE_URL}${route('hoy-no-circula', 'es')}`} target="_blank" rel="noopener" class="font-medium text-accent-700 underline">Hoy No Circula hoy, calendario y contingencias: {SITE_NAMES.es}</a></p>
</body></html>
